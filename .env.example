# --- Deepseek (Code Analysis Fallback) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- AO / Arweave ---
ARWEAVE_WALLET_PATH=./wallet.json
AO_GATEWAY=https://mu.ao-testnet.xyz
AO_CU_URL=https://cu.ao-testnet.xyz
PULSE_PROCESS_ID=E8gHiH6gpkfFZywTbQj13F9SUH8N9tWrFsgGisOPHV4

# --- Agent Configuration ---
MODEL_STRATEGY=cost-performance    # speed | quality | cost-performance
ENABLE_FALLBACK=true
MAX_RETRIES=3
RATE_LIMIT_RPM=60

# --- Logging ---
LOG_LEVEL=info                     # debug | info | warn | error
LOG_TOKEN_USAGE=true
